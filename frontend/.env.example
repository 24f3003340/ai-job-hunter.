# Placeholders only. VITE_* values are compiled into the public bundle: NEVER put secrets here.
# Base URL of the backend API. Default "/api/v1" = same origin (Vite proxies /api in dev; use a reverse proxy in prod).
VITE_API_URL=/api/v1
# Dev only: where the Vite dev server proxies /api to.
VITE_DEV_PROXY_TARGET=http://127.0.0.1:8000
