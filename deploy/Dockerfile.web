# Static frontend + HTTPS reverse proxy (Caddy). Build context: repository root.
FROM node:22-slim AS build
WORKDIR /src/frontend
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci
COPY frontend/ ./
# Same-origin API: the browser calls /api/v1 on this host and Caddy forwards it to the backend.
ENV VITE_API_URL=/api/v1
RUN npm run build

FROM caddy:2
COPY --from=build /src/frontend/dist /srv
COPY deploy/Caddyfile /etc/caddy/Caddyfile
