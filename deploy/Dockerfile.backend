# FastAPI backend. Build context: repository root.   docker build -f deploy/Dockerfile.backend -t jobhunter-backend .
FROM python:3.13-slim AS base
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1
RUN useradd --system --uid 10001 --home /srv/backend --shell /usr/sbin/nologin app \
 && mkdir -p /srv/backend /var/lib/jobhunter/storage && chown -R app /srv/backend /var/lib/jobhunter
WORKDIR /srv/backend
COPY backend/pyproject.toml ./
COPY backend/app ./app
COPY backend/migrations ./migrations
COPY backend/alembic.ini ./
COPY backend/scripts ./scripts
RUN pip install .
USER app
ENV JOBHUNTER_STORAGE_DIR=/var/lib/jobhunter/storage
EXPOSE 8000
HEALTHCHECK --interval=15s --timeout=5s --start-period=20s --retries=5 \
  CMD python -c "import urllib.request,sys; sys.exit(0 if urllib.request.urlopen('http://127.0.0.1:8000/health', timeout=3).status==200 else 1)"
# Schema changes are applied by the separate one-shot `migrate` service, never implicitly by app replicas.
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "2", "--proxy-headers", "--forwarded-allow-ips", "*", "--no-server-header"]
