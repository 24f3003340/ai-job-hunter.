# Copy to deploy/.env.staging (git-ignored). Generate secrets with:  openssl rand -base64 33 | tr -d '/+=' 
SITE_ADDRESS=staging.example.com           # public DNS name pointing at this host (use "localhost" for a local smoke test)
POSTGRES_PASSWORD=CHANGE_ME
REDIS_PASSWORD=CHANGE_ME
EMAIL_FROM=no-reply@staging.example.com
SMTP_HOST=smtp.example.com                 # your provider's submission host (TLS required; plaintext is refused)
SMTP_PORT=587
SMTP_USER=CHANGE_ME
SMTP_PASSWORD=CHANGE_ME
SMTP_SECURITY=starttls                     # starttls | ssl
# Malware scanning: either run the clamav profile and set CLAMAV_HOST=clamav, or consciously accept unscanned uploads.
CLAMAV_HOST=
ALLOW_UNSCANNED_UPLOADS=false
# AI: rule_based keeps all data on the server. "anthropic" also needs a key and per-user consent.
AI_PROVIDER=rule_based
ANTHROPIC_API_KEY=
