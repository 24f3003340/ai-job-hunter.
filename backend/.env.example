# Copy to .env and fill in. Placeholders only: never commit real values.
JOBHUNTER_ENV=development                 # development | test | production
JOBHUNTER_DATABASE_URL=sqlite:///./jobhunter.db
# production example: postgresql+psycopg://USER:PASSWORD@HOST:5432/DBNAME
JOBHUNTER_PUBLIC_BASE_URL=http://localhost:5173
JOBHUNTER_CORS_ORIGINS=["http://localhost:5173"]

# Auth / e-mail
JOBHUNTER_REQUIRE_VERIFIED_EMAIL=false    # must be true in production
JOBHUNTER_EMAIL_BACKEND=file              # file (dev: .eml files in MAIL_DIR) | console (metadata only) | smtp (production)
JOBHUNTER_MAIL_DIR=./var/mail
JOBHUNTER_EMAIL_FROM=no-reply@example.invalid
JOBHUNTER_SMTP_HOST=
JOBHUNTER_SMTP_PORT=587
JOBHUNTER_SMTP_USER=
JOBHUNTER_SMTP_PASSWORD=
JOBHUNTER_SMTP_SECURITY=starttls          # starttls | ssl ; "none" only for a local dev sink WITHOUT credentials
JOBHUNTER_SMTP_CA_FILE=                   # optional PEM bundle if your server uses a private CA
JOBHUNTER_SMTP_TIMEOUT_SECONDS=15

# Rate limits ("<count>/<second|minute|hour|day>")
JOBHUNTER_RATE_LIMIT_ENABLED=true
JOBHUNTER_RATE_LIMIT_DEFAULT=300/minute
JOBHUNTER_RATE_LIMIT_AUTH=10/minute
JOBHUNTER_RATE_LIMIT_UPLOAD=10/hour
JOBHUNTER_RATE_LIMIT_GENERATE=20/hour
JOBHUNTER_TRUST_PROXY_HEADERS=false       # true only behind a proxy you control
JOBHUNTER_RATE_LIMIT_BACKEND=memory       # memory (ONE worker only) | redis (required for production)
JOBHUNTER_REDIS_URL=                      # e.g. rediss://:PASSWORD@HOST:6379/0
JOBHUNTER_REDIS_TIMEOUT_SECONDS=0.25
JOBHUNTER_RATE_LIMIT_CRITICAL_FAIL_MODE=closed   # closed (503 if Redis is down) | local (per-process fallback)
JOBHUNTER_ALLOW_PROCESS_LOCAL_RATE_LIMIT=false   # production + exactly one worker only

# Uploads
JOBHUNTER_STORAGE_DIR=./var/storage       # keep outside any web-served directory
JOBHUNTER_MAX_UPLOAD_BYTES=5242880
JOBHUNTER_ALLOWED_UPLOAD_TYPES=["pdf","docx"]
JOBHUNTER_CLAMAV_HOST=                    # empty = malware scanning NOT configured
JOBHUNTER_CLAMAV_PORT=3310
JOBHUNTER_CLAMAV_TIMEOUT_SECONDS=10
JOBHUNTER_REQUIRE_MALWARE_SCAN=false
JOBHUNTER_ALLOW_UNSCANNED_UPLOADS=false   # production refuses to start unscanned unless this is true

# AI provider: rule_based (local, nothing leaves the server) | anthropic
JOBHUNTER_AI_PROVIDER=rule_based
JOBHUNTER_ANTHROPIC_API_KEY=
JOBHUNTER_ANTHROPIC_MODEL=claude-sonnet-5-5

# --- test-only (never set in a deployed environment) ---
# JOBHUNTER_TEST_DATABASE_URL=postgresql+psycopg://USER:PASSWORD@127.0.0.1:5433/jobhunter_test
# JOBHUNTER_TEST_REDIS_URL=redis://127.0.0.1:6380/0
# JOBHUNTER_TEST_CLAMAV_HOST=127.0.0.1          # enables tests/external/test_clamav_real.py
# JOBHUNTER_RUN_EXTERNAL=1                      # + JOBHUNTER_ANTHROPIC_API_KEY enables the live Anthropic test (costs money)
